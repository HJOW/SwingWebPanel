<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.duckdns.hjow</groupId>
    <artifactId>swingwebpanel-parent</artifactId>
    <version>0.2.0</version>
  </parent>
  <artifactId>swingwebpanel-desktopapp</artifactId>
  <name>SwingWebPanel Browser</name>
  <description>Swing web browser application built on SwingWebPanel</description>
  <properties>
    <swp.jdk6.checkPhase>none</swp.jdk6.checkPhase>
    <maven.deploy.skip>true</maven.deploy.skip>
    <swp.createdBy>desktopapp (JDK 6)</swp.createdBy>
    <!-- 시험은 앱 클래스 디렉터리와 브라우저 제품으로 실행한다. -->
    <swp.test.runtimePath>${project.build.outputDirectory}</swp.test.runtimePath>
    <swp.desktopapp.jar>${project.build.directory}/swingwebpanel-desktopapp.jar</swp.desktopapp.jar>
    <!-- 시험이 실제 사용자의 설정과 북마크를 건드리지 않도록 사용자 데이터 위치를 target 아래로 돌린다(시험은 모듈 디렉터리에서 실행된다). -->
    <swp.test.jvmArgs>-XX:MaxPermSize=256m -Dswingwebpanel.desktopapp.home=target/test-home</swp.test.jvmArgs>
  </properties>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>swingwebpanel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>swingwebpanel-tls13</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <!-- 앱과 SwingWebPanel 클래스를 합친 실행 JAR. JRE 6 에서 java -jar 로 실행한다. -->
          <execution>
            <id>app-jar</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/app.xml</descriptor></descriptors>
              <finalName>swingwebpanel-desktopapp</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <attach>false</attach>
              <archive>
                <addMavenDescriptor>false</addMavenDescriptor>
                <manifest>
                  <addDefaultEntries>false</addDefaultEntries>
                  <mainClass>org.duckdns.hjow.swingwebpanel.desktopapp.Main</mainClass>
                </manifest>
                <manifestEntries>
                  <Implementation-Title>${project.name}</Implementation-Title>
                  <Implementation-Version>${project.version}</Implementation-Version>
                  <Created-By>${swp.createdBy}</Created-By>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>run-regression</id>
            <phase>test</phase>
          </execution>
          <execution>
            <!-- 실행 JAR 을 JDK 6 의 java -jar 로 실제 실행해 본다(화면 없이 페이지 하나를 읽고 끝난다). -->
            <id>run-app-smoke</id>
            <phase>verify</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <target>
                <java jar="${swp.desktopapp.jar}" jvm="${swp.java}" fork="true" resultproperty="swp.desktopapp.smoke" timeout="120000">
                  <jvmarg line="${swp.test.jvmArgs}"/>
                  <sysproperty key="swingwebpanel.desktopapp.home" value="${project.build.directory}/smoke-home"/>
                  <arg value="--smoke"/>
                </java>
                <fail message="java -jar swingwebpanel-desktopapp.jar --smoke must exit with code 0 but the code was ${swp.desktopapp.smoke}.">
                  <condition>
                    <not><equals arg1="${swp.desktopapp.smoke}" arg2="0"/></not>
                  </condition>
                </fail>
                <echo level="info">Desktop app smoke run passed (java -jar on JDK 6).</echo>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>compile-regression-tests</id>
      <activation><property><name>maven.test.skip</name><value>!true</value></property></activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>swingwebpanel-tls13</artifactId>
          <version>${project.version}</version>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>swingwebpanel-js</artifactId>
          <version>${project.version}</version>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
